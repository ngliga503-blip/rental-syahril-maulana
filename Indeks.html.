    <!-- JAVASCRIPT SYSTEM LOGIC -->
    <script>
        const WA_NUMBER = "62895393728347";

        // Price Matrix
        const prices = {
            onsite: {
                ps3: { "1h": 8000, "2h": 16000, "3h": 24000, "5h": 35000 },
                ps4: { "1h": 12000, "2h": 24000, "3h": 36000, "5h": 55000 },
                ps5: { "1h": 20000, "2h": 40000, "3h": 60000, "5h": 90000 }
            },
            delivery: {
                ps3: { "12h": 45000, "24h": 60000, "48h": 115000, "7d": 350000 },
                ps4: { "12h": 75000, "24h": 100000, "48h": 190000, "7d": 550000 },
                ps5: { "12h": 110000, "24h": 150000, "48h": 280000, "7d": 850000 }
            }
        };

        const durationLabels = {
            onsite: [
                { val: "1h", text: "1 Jam" },
                { val: "2h", text: "2 Jam" },
                { val: "3h", text: "3 Jam" },
                { val: "5h", text: "Paket 5 Jam (Hemat)" }
            ],
            delivery: [
                { val: "12h", text: "12 Jam" },
                { val: "24h", text: "24 Jam (1 Hari)" },
                { val: "48h", text: "48 Jam (2 Hari)" },
                { val: "7d", text: "Paket Mingguan (7 Hari)" }
            ]
        };

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        function updateDurationOptions() {
            const orderType = document.getElementById('orderType').value;
            const durationSelect = document.getElementById('duration');
            const addressField = document.getElementById('addressField');

            durationSelect.innerHTML = '';
            durationLabels[orderType].forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.val;
                opt.textContent = item.text;
                durationSelect.appendChild(opt);
            });

            if (orderType === 'onsite') {
                addressField.style.display = 'none';
                document.getElementById('deliveryFee').textContent = 'Tidak Ada (Main di Tempat)';
            } else {
                addressField.style.display = 'block';
                document.getElementById('deliveryFee').textContent = 'Gratis (Area Lokal)';
            }
        }

        function calculateTotal() {
            const psType = document.getElementById('psType').value;
            const orderType = document.getElementById('orderType').value;
            const duration = document.getElementById('duration').value;

            const price = prices[orderType][psType][duration] || 0;

            document.getElementById('packagePrice').textContent = `Rp ${price.toLocaleString('id-ID')}`;
            document.getElementById('totalPrice').textContent = `Rp ${price.toLocaleString('id-ID')}`;
        }

        function selectConsole(type) {
            document.getElementById('psType').value = type;
            calculateTotal();
        }

        function sendToWhatsApp(e) {
            e.preventDefault();

            const psType = document.getElementById('psType').options[document.getElementById('psType').selectedIndex].text;
            const orderType = document.getElementById('orderType').options[document.getElementById('orderType').selectedIndex].text;
            const duration = document.getElementById('duration').options[document.getElementById('duration').selectedIndex].text;
            const startDate = document.getElementById('startDate').value;
            const custName = document.getElementById('custName').value;
            const paymentMethod = document.getElementById('paymentMethod').value;
            const address = document.getElementById('address').value;
            const totalPrice = document.getElementById('totalPrice').textContent;

            let message = `*HALO RENTAL MAULANA, SAYA INGIN SEWA PLAYSTATION*\n\n`;
            message += `👤 *Nama Pemesan:* ${custName}\n`;
            message += `🎮 *Tipe PS:* ${psType}\n`;
            message += `📍 *Bentuk Pemesanan:* ${orderType}\n`;
            message += `⏱️ *Durasi Sewa:* ${duration}\n`;
            message += `📅 *Waktu Sewa:* ${startDate}\n`;
            if (document.getElementById('orderType').value === 'delivery') {
                message += `🏠 *Alamat Pengantaran:* ${address || '-'}\n`;
            }
            message += `💳 *Metode Pembayaran:* ${paymentMethod}\n`;
            message += `💰 *Total Tagihan:* *${totalPrice}*\n\n`;
            message += `Mohon konfirmasi ketersediaan unitnya. Terima kasih!`;

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${WA_NUMBER}?text=${encodedMessage}`, '_blank');
        }

        // Set Default Date & Options
        window.onload = function() {
            updateDurationOptions();
            calculateTotal();

            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('startDate').value = now.toISOString().slice(0,16);
        };
    </script>
